# ------------------------------------------------------------------
# Super Ludoteca — variables de entorno
# Copia este archivo como ".env.local" y rellena tus claves.
# Si dejas las 6 de Firebase vacías, la app funciona igualmente en
# "Modo Invitado Local" (datos solo en este dispositivo).
# ------------------------------------------------------------------

# Firebase (Consola → ⚙️ Configuración del proyecto → Tus apps → Web `</>`)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcionales: chat de dudas con IA (también configurables en la app → Ajustes)
# Gemini (gratuita): https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
# DeepSeek: https://platform.deepseek.com
VITE_DEEPSEEK_API_KEY=
